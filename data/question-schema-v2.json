          "minimum": 1
        },
        "domain": {
          "enum": [
            "People",
            "Process",
            "Business Environment"
          ]
        },
        "approach": {
          "enum": [
            "Agile",
            "Hybrid",
            "Predictive"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*�)[\\s\\S]*\\S[\\s\\S]*$"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*�)[\\s\\S]*\\S[\\s\\S]*$"
        },
        "opts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*�)[\\s\\S]*\\S[\\s\\S]*$"
          },
          "uniqueItems": true
        },
        "ans": {},
        "exp": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*�)[\\s\\S]*\\S[\\s\\S]*$"
        },
        "difficulty": {
