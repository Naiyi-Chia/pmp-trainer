  "$id": "https://naiyi-chia.github.io/pmp-trainer/data/question-schema-v2.json",
  "title": "PMP Trainer Question Bank v2",
  "description": "Structural contract; additionally validate unique IDs, count agreement and answer indices with tooling. Current publication profile is 330 approved single-response questions with four options.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_count",
    "eco_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "eco_version": {
      "const": "2026"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
